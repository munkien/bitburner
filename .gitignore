# Installed dependencies. Reproducible from package-lock.json.
node_modules/

# Built UI bundle, regenerated by `npm run build:ui`. Its asset filenames carry a
# content hash, so every rebuild would otherwise leave a dead bundle in history.
# Nothing reads it at runtime — the sync server serves the game, not this.
dist/

# The game's type definitions, written by file sync on connection
# (`filesync.json` → `definitionFile.location`). Generated, not authored. A clone
# that has not connected to the game will not typecheck until it reappears.
NetscriptDefinitions.d.ts

# Vendored agent skill packs, in both copies. Reproducible from the two
# `skills-lock.json` files, which ARE tracked. `filesync.json` already excludes
# `.agents` from what it pushes to the game, so this is tooling the project has
# declared it does not ship.
.agents/

# Recorded run telemetry: ~54MB of jsonl. This is EVIDENCE, not source — it is
# what `scripts/run-summary.mjs` reads and what the goal-ranking behaviour was
# measured against. Valuable, but it belongs in a data store.
runs/
